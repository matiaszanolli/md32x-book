+/* VF: instruction histogram + call log */
+static struct { unsigned long long key; unsigned long long n; } vfh_tab[1<<18];
+static unsigned long long vf_ni[2]; static int vfh_init; static FILE *vfh_log, *vfc_log; static unsigned long long vfc_lines, vfc_max = 2000000;
+void vf_flush(void);
+void vf_instr(SH2 *sh2, unsigned pc, unsigned op) {
+  vf_ni[sh2->is_slave]++;
+  if (!vfh_init) { const char *f = getenv("VF_PCH"), *c = getenv("VF_CALLS"), *m = getenv("VF_CALLS_MAX"); vfh_init = 1; atexit(vf_flush);
+    if (f) vfh_log = fopen(f, "w"); if (c) vfc_log = fopen(c, "w"); if (m) vfc_max = strtoull(m, 0, 0); }
+  if (vfh_log) {
+    unsigned i, h; unsigned long long key = ((unsigned long long)sh2->is_slave << 32) | pc;
+    h = (unsigned)((key * 11400714819323198485ull) >> 46);
+    for (i = 0; i < (1u<<18); i++) { unsigned idx = (h + i) & ((1u<<18)-1);
+      if (vfh_tab[idx].n && vfh_tab[idx].key != key) continue;
+      vfh_tab[idx].key = key; vfh_tab[idx].n++; break; }
+  }
+  if (vfc_log && vfc_lines < vfc_max) {
+    unsigned tgt = 0; int kind = 0;
+    if ((op & 0xf0ff) == 0x400b) { tgt = sh2->r[(op >> 8) & 15]; kind = 'C'; }
+    else if ((op & 0xf000) == 0xb000) { tgt = pc + 4 + (((int)(op << 20)) >> 19); kind = 'C'; }
+    else if ((op & 0xf0ff) == 0x0003) { tgt = pc + 4 + sh2->r[(op >> 8) & 15]; kind = 'C'; }
+    else if ((op & 0xf0ff) == 0x402b) { tgt = sh2->r[(op >> 8) & 15]; kind = 'J'; }
+    else if (op == 0x000b) { kind = 'R'; tgt = sh2->pr; }
+    else if (op == 0x002b) { kind = 'E'; }
+    if (kind) { vfc_lines++; fprintf(vfc_log, "%u %c%c %08x %08x %llu\n", sh2_cycles_done_m68k(sh2), sh2->is_slave ? 'S' : 'M', kind, pc, tgt, vf_ni[sh2->is_slave]); }
+  }
+}
+void vf_irq(SH2 *sh2, int level, int vector) { if (vfc_log && vfc_lines < vfc_max) { vfc_lines++; fprintf(vfc_log, "%u %cI %08x %08x %llu\n", sh2_cycles_done_m68k(sh2), sh2->is_slave ? 'S' : 'M', sh2->pc, level * 256 + vector, vf_ni[sh2->is_slave]); } }
+void vf_flush(void) { int i; if (vfh_log) { for (i=0;i<(1<<18);i++) if (vfh_tab[i].n) fprintf(vfh_log,"%c %08x %llu\n", (vfh_tab[i].key>>32)?'S':'M', (unsigned)vfh_tab[i].key, vfh_tab[i].n); fclose(vfh_log); vfh_log = 0; } if (vfc_log) { fclose(vfc_log); vfc_log = 0; } }
