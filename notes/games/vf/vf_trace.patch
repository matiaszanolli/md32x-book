+/* VF: access tracer, count SH2 accesses by cpu/region/pc */
+#include <stdio.h>
+#include <stdlib.h>
+static struct { unsigned key; unsigned long long n; } vf_tab[1<<16];
+static int vf_init; static FILE *vf_log;
+static unsigned long long vf_sd[2][2][1024]; static unsigned long long vf_cart[2][1024];
+static void vf_dump(void) {
+  int i, c, w; for (c = 0; c < 2; c++) for (i = 0; i < 1024; i++) if (vf_cart[c][i]) fprintf(vf_log, "cart cpu%d blk %06x %llu\n", c, i << 12, vf_cart[c][i]);
+  for (c = 0; c < 2; c++) for (w = 0; w < 2; w++) for (i = 0; i < 1024; i++) if (vf_sd[c][w][i]) fprintf(vf_log, "sdram cpu%d %c blk %05x %llu\n", c, w ? 'W' : 'R', i << 8, vf_sd[c][w][i]);
+  for (i = 0; i < (1<<16); i++) if (vf_tab[i].n) {
+    unsigned k = vf_tab[i].key;
+    fprintf(vf_log, "cpu%d region%d %c w%d pc %08x %llu\n", (k>>31)&1, (k>>24)&0xf, (k&(1u<<30))?'W':'R', (k>>28)&3, (k&0xffffff)<<4, vf_tab[i].n); }
+  fclose(vf_log); }
+static int vf_region(unsigned a) {
+  unsigned b = a & 0x1fffffff;
+  if (b >= 0x04000000 && b < 0x04020000) return 1;   /* frame buffer */
+  if (b >= 0x04020000 && b < 0x04040000) return 2;   /* overwrite image */
+  if (b >= 0x06000000 && b < 0x06040000) return 3;   /* SDRAM */
+  if (b >= 0x02000000 && b < 0x02400000) return 4;   /* cartridge */
+  if (b >= 0x4100 && b < 0x4200 && (a>>29)!=7) return 5;     /* VDP regs */
+  if (b >= 0x4200 && b < 0x4400 && (a>>29)!=7) return 6;     /* palette */
+  if (b >= 0x4030 && b < 0x4040 && (a>>29)!=7) return 7;     /* PWM */
+  if (b >= 0x4000 && b < 0x4030 && (a>>29)!=7) return 8;     /* sys regs */
+  if ((a>>29)==6) return 9;                           /* on-chip RAM / data array */
+  if ((a>>29)==7) return 10;                          /* on-chip regs */
+  if (b < 0x4000) return 11;                          /* boot rom */
+  return 12;
+}
+static FILE *vf_evt; static int vf_evt_init;
+static void vf_ev(int cpu, unsigned t, unsigned a, unsigned d, int w, int wr) {
+  if (!vf_evt_init) { const char *f = getenv("VF_EVT"); vf_evt_init = 1; if (f) vf_evt = fopen(f, "w"); }
+  if (vf_evt) fprintf(vf_evt, "%u %c%c%d %08x %x\n", t, "MSK"[cpu], wr?'W':'R', w, a, d);
+}
+static unsigned vfw_lo, vfw_hi; static FILE *vfw_log; static int vfw_init; static unsigned long long vfw_n, vfw_max = 200000;
+static void vf_watch(SH2 *sh2, unsigned a, int wr, int w, unsigned d) {
+  if (!vfw_init) { const char *r = getenv("VF_WATCH"), *l = getenv("VF_WATCH_LOG"), *m = getenv("VF_WATCH_MAX"); vfw_init = 1;
+    if (r && l && sscanf(r, "%x-%x", &vfw_lo, &vfw_hi) == 2) vfw_log = fopen(l, "w"); if (m) vfw_max = strtoull(m, 0, 0); }
+  if (!vfw_log || vfw_n >= vfw_max) return;
+  { unsigned b = a & 0x1fffffff; if (b >= vfw_lo && b < vfw_hi) { vfw_n++; fprintf(vfw_log, "%u %c %c%d %08x %08x %08x\n", sh2_cycles_done_m68k(sh2), sh2->is_slave ? 'S' : 'M', wr ? 'W' : 'R', w, sh2->ppc, a, d); } }
+}
+static void vf_acc(SH2 *sh2, unsigned a, int wr, int w, unsigned d) {
+  vf_watch(sh2, a, wr, w, d);
+  unsigned key, h, pc; int r, i;
+  if (!vf_init) { const char *f = getenv("VF_TRACE"); vf_init = 1; if (f && (vf_log = fopen(f, "w"))) atexit(vf_dump); }
+  if (!vf_log) return;
+  r = vf_region(a); pc = sh2->ppc >> 4;
+  if (r == 3) vf_sd[sh2->is_slave][wr ? 1 : 0][(a >> 8) & 1023]++;
+  if (r == 4) vf_cart[sh2->is_slave][(a >> 12) & 1023]++;
+  key = ((unsigned)sh2->is_slave << 31) | (wr ? (1u<<30) : 0) | ((unsigned)(r & 0xf) << 24) | (pc & 0xffffff);
+  /* width folded into key through region bits 29-28 */
+  key |= ((unsigned)(w == 1 ? 0 : w == 2 ? 1 : 2)) << 28;
+  h = (key * 2654435761u) >> 16;
+  for (i = 0; i < (1<<16); i++) {
+    unsigned idx = (h + i) & 0xffff;
+    if (vf_tab[idx].n && vf_tab[idx].key != key) continue;
+    vf_tab[idx].key = key; vf_tab[idx].n++; return; }
+}
